                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="10,8" Margin="0,2" Background="{StaticResource ChipBackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource CardBackgroundBrush}"
                                                        ClipToBounds="True" Tag="15" SizeChanged="RoundCorners_SizeChanged">
                                                    <TextBlock Text="{Binding User[0]}" FontSize="13" FontWeight="Light" Opacity="0.4"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding User}" FontSize="13" FontWeight="SemiBold"
                                                                   MouseEnter="UserName_MouseEnter" MouseLeave="UserName_MouseLeave"
                                                                   Cursor="Hand"
                                                                   Foreground="{Binding Badges, Converter={StaticResource UsernameBrushConv}, ConverterParameter=#EAEAEA}" />
                                                        <ContentControl Margin="6,0,0,0" VerticalAlignment="Center"
                                                                        Content="{Binding Badges, Converter={StaticResource BadgeIconRowConv}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Bio}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="FindUserActionButton" Content="Add" Style="{StaticResource PillButton}"
                                                        Padding="12,6" FontSize="11" Margin="8,0,0,0" Click="FindUserAction_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="FindUserStatusText" Text="" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,10,0,0" />
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,14,0,0" Click="FindUserClose_Click" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="NewGroupOverlay" Visibility="Collapsed" Background="#EE101014">
                <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{StaticResource ContentBackgroundBrush}" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="28,24">
                    <StackPanel>
                        <TextBlock x:Name="NewGroupOverlayTitle" Text="New group" FontSize="22" FontWeight="Light" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="CommunityGroupHintText" Text="Pick friends and name your group. Everyone can add more friends later."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,14" />
                        <StackPanel x:Name="NewGroupNameRow" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock x:Name="NewGroupNameLabel" Text="Group name:" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="NewGroupNameBox" Style="{StaticResource SearchBox}" Height="34" Width="220"
                                     TextChanged="NewGroupName_TextChanged" />
                        </StackPanel>
                        <TextBlock x:Name="CustomGroupNameText" Text="Add members" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="NewGroupFriendsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding User}" IsChecked="{Binding Selected}" Margin="2,4"
                                                  Foreground="{StaticResource TextPrimaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="NewGroupStatusText" Text="" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,10,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button x:Name="NewGroupCreateButton" Content="Create group" Style="{StaticResource PillButton}" Padding="16,8" Click="NewGroupCreate_Click" />
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="34" Margin="12,0,0,0" Click="NewGroupCancel_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,25,25" />
            <Grid x:Name="DialogOverlay" Visibility="Collapsed">
                <Rectangle Fill="#AA000000" />
                <Border MaxWidth="430" Background="{StaticResource ContentBackgroundBrush}" CornerRadius="14"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="26,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="DialogEmoji" Text="⚠️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock x:Name="DialogTitle" Text="Title" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
<TextBlock x:Name="DialogMessage" Text="Message" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" LineHeight="21" />
                        <TextBox x:Name="DialogInputBox" Style="{StaticResource SearchBox}" Height="34" Margin="0,12,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="DialogButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="UserHoverCard" Visibility="Collapsed" Width="238" IsHitTestVisible="False"
                    Background="{StaticResource ContentBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <Border x:Name="UserHoverBanner" Height="46" CornerRadius="12,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush x:Name="UserHoverBannerBrush" StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="UserHoverGradA" Color="#FF7B2FFF" Offset="0" />
                                <GradientStop x:Name="UserHoverGradB" Color="#FF2F8DFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="12,-18,11,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="UserHoverAvatar" Width="46" Height="46" CornerRadius="23"
                                Background="{StaticResource AppBackgroundBrush}" ClipToBounds="True"
                                BorderBrush="#33000000" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="UserHoverInitial" Text="?" FontSize="16" FontWeight="Light" Opacity="0.4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="UserHoverAvatarImage" Stretch="UniformToFill"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UserHoverName" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                <ContentControl x:Name="UserHoverBadges" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="UserHoverJoined" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock x:Name="UserHoverBio" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>