                                <ComboBoxItem Content="🔥  Most Popular" />
                                <ComboBoxItem Content="🕐  Recently Added" />
                                <ComboBoxItem Content="⭐  Top Rated" />
                                <ComboBoxItem Content="⬇  Most Downloaded" />
                            </ComboBox>
                            <ComboBox x:Name="CategoryCombo" Grid.Column="2" Style="{StaticResource DarkCombo}" Height="40" MinWidth="150"
                                      SelectedIndex="0" SelectionChanged="CategoryCombo_SelectionChanged"
                                      ToolTip="Official mods are reviewed by the AMC Studios team. Unverified mods are community uploads.">
                                <ComboBoxItem Content="🛡  All Verified" />
                                <ComboBoxItem Content="✅  Official" />
                                <ComboBoxItem Content="⚠  Unverified" />
                            </ComboBox>
                            <Button x:Name="StoreRefreshButton" Content="↻" Grid.Column="3" Style="{StaticResource SecondaryButton}"
                                    Width="40" Height="40" Padding="0,10" FontSize="16" Margin="12,0,0,0" Click="StoreRefresh_Click" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="StoreList" ItemTemplate="{StaticResource StoreCardTemplate}"
                                              ItemsPanel="{StaticResource ModGridPanel}" />
                            </ScrollViewer>
                            <StackPanel x:Name="StoreStatusPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="StoreStatusEmoji" Text="📦" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock x:Name="StoreStatusText" Text="Loading mods..." FontSize="17" FontWeight="Light"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button x:Name="StoreRetryButton" Content="Try Again" Style="{StaticResource PrimaryButton}" Width="160" Margin="0,18,0,0"
                                        HorizontalAlignment="Center" Click="StoreRetry_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ModsPage" Visibility="Collapsed" Margin="25,8,25,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,4,0,14">
                            <StackPanel>
                                <TextBlock Text="My Mods" FontSize="26" FontWeight="Light" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Everything you have installed. Update, re-icon, or remove mods safely."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="⬆  Upload Mod" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,8,0"
                                        Click="UploadOpen_Click" ToolTip="Publish your own mod to the community (max 5 MB)" />
                                <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" Padding="14,7" Click="ModsRefresh_Click" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ModsList" ItemTemplate="{StaticResource InstalledModTemplate}" />
                            </ScrollViewer>
                            <StackPanel x:Name="ModsEmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🗂️" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="No mods installed yet." FontSize="17" FontWeight="Light" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <Button Content="Browse the Mod Store" Style="{StaticResource PrimaryButton}" Width="230" Margin="0,18,0,0"
                                        HorizontalAlignment="Center" Click="GoToStore_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CommunityPage" Visibility="Collapsed" Margin="25,8,25,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="248" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,10">
                                    <Button x:Name="ChannelsTabButton" Content="Channels" Style="{StaticResource PillButton}" Padding="14,7" Click="CommunityChannelsTab_Click" />
                                    <Button x:Name="FriendsTabButton" Content="Friends" Style="{StaticResource PillButton}" Padding="14,7" Margin="8,0,0,0" Click="CommunityFriendsTab_Click" />
                                    <Button x:Name="DmsTabButton" Content="DMs" Style="{StaticResource PillButton}" Padding="14,7" Margin="8,0,0,0" Click="CommunityDmsTab_Click" />
                                </StackPanel>
                                <ScrollViewer x:Name="CommunityChannelsView" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                    <StackPanel Margin="8,0,8,8">
                                        <TextBlock Text="PUBLIC CHANNELS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="10,6,0,6" />
                                        <ItemsControl x:Name="CommunityChannelList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="9" Padding="10,9" Margin="0,2" Cursor="Hand"
                                                            Background="Transparent" MouseLeftButtonDown="CommunityChannel_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button x:Name="CommunityAddFriendChannelButton" Content="＋  Find friends" Style="{StaticResource PillButton}"
                                                Margin="10,8,10,6" Click="CommunityOpenAddFriend_Click" />
                                        <TextBlock Text="FRIEND REQUESTS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="10,8,0,6" Visibility="Collapsed" />
                                        <ItemsControl x:Name="CommunityFriendRequestsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="9" Padding="10,8" Margin="0,2" Background="{StaticResource ChipBackgroundBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button Content="Accept" Style="{StaticResource PillButton}" Padding="9,5" FontSize="10.5" Click="CommunityAcceptFriend_Click" />
                                                                <Button Content="✕" Style="{StaticResource PillButton}" Padding="9,5" FontSize="10.5" Margin="4,0,0,0" Click="CommunityDeclineFriend_Click" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid x:Name="CommunityFriendsView" Grid.Row="1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="8,2,8,6">
                                        <TextBox x:Name="CommunityAddFriendBox" Style="{StaticResource SearchBox}" Height="34" FontSize="12.5"
                                                 KeyDown="CommunityAddFriend_KeyDown" />
                                        <TextBlock x:Name="CommunityAddFriendPlaceholder" Text="Add friend by username..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
