                                MouseLeftButtonDown="AccountChip_Click" ToolTip="Your AMC Store account - click to sign in or view profile">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,12,0">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentGradientBrush}"
                                        ClipToBounds="True" Tag="12" SizeChanged="RoundCorners_SizeChanged">
                                    <Grid>
                                        <TextBlock x:Name="AccountChipInitial" Text="?" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="AccountChipAvatar"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AccountChipName" Text="Sign In" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Content="Change Folder" Style="{StaticResource SecondaryButton}" Padding="12,7" Click="ChangeFolderButton_Click" Margin="0,0,8,0" />
                        <Button Content="✕" Style="{StaticResource SecondaryButton}" Width="38" Padding="0,7" Click="ExitButton_Click" FontSize="14" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" x:Name="PageContainer">
                    <Grid x:Name="HomePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="25,8,25,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="News &amp; Announcements" FontSize="26" FontWeight="Light" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,6" Click="RefreshAnnouncements_Click" />
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AnnouncementsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="18,14" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGradientBrush}" VerticalAlignment="Top" Margin="0,6,12,0" />
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource ContentBackgroundBrush}" Padding="25,12,25,12" Margin="0,10,0,0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎮" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CurrentGamePathText" Text="{Binding CurrentGamePath}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="Launcher Isn't working? check status.acutebunny.vip"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:Name="StorePage" Visibility="Collapsed" Margin="25,8,25,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,4,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="40" TextChanged="SearchBox_TextChanged"
                                         KeyDown="SearchBox_KeyDown" />
                                <TextBlock x:Name="SearchPlaceholder" Text="🔍  Search free mods..." FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <ComboBox x:Name="SortCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Height="40" Margin="12,0,0,0"
