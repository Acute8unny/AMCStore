                                        <Button Content="＋  New group" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                                                Click="CommunityNewGroup_Click" />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel>
                                            <ItemsControl x:Name="CommunityDmList">
