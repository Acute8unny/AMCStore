                                    <StackPanel>
                                        <ItemsControl x:Name="CommunityMessagesList" Margin="12,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="ChatRow" Margin="0,7" HorizontalAlignment="{Binding IsMine, Converter={StaticResource LeftRightConv}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{StaticResource ChipBackgroundBrush}"
                                                                ClipToBounds="True" Tag="17" SizeChanged="RoundCorners_SizeChanged"
                                                                Visibility="{Binding IsMine, Converter={StaticResource InverseBoolToVis}}">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Light" Opacity="0.35"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding User}" FontSize="12" FontWeight="SemiBold"
                                                                           MouseEnter="UserName_MouseEnter" MouseLeave="UserName_MouseLeave"
                                                                           Cursor="Hand"
                                                                           Foreground="{Binding Badges, Converter={StaticResource UsernameBrushConv}, ConverterParameter=#50A0FF}" />
                                                                <ContentControl Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                Content="{Binding Badges, Converter={StaticResource BadgeIconRowConv}}" />
                                                                <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
