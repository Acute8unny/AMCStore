                                                                MouseLeftButtonDown="CommunityDmConvo_Click">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource ChipBackgroundBrush}"
                                                                        ClipToBounds="True" Tag="16" SizeChanged="RoundCorners_SizeChanged">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Light" Opacity="0.35"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
<TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                                       MouseEnter="UserName_MouseEnter" MouseLeave="UserName_MouseLeave"
                                                                       Cursor="Hand"
                                                                       Foreground="{Binding Badges, Converter={StaticResource UsernameBrushConv}, ConverterParameter=#EAEAEA}" />
                                                                        <ContentControl Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                        Content="{Binding Badges, Converter={StaticResource BadgeIconRowConv}}" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding SubLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding LastPreview}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="CommunityNoDmsText" Text="No conversations yet." FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="10,12,10,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,11" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="CommunityChatTitle" Text="General" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="CommunityChatTypeBadge" Text="PUBLIC CHANNEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"
                                                       Margin="10,3,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="CommunityChatDesc" Text="" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel x:Name="CommunityGroupActions" Orientation="Horizontal" Visibility="Collapsed">
                                            <Button Content="＋ Add" Style="{StaticResource PillButton}" Padding="10,6" FontSize="12" Margin="0,0,8,0"
