                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel>
                                            <ItemsControl x:Name="CommunityFriendsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="9" Padding="10,7" Margin="0,2" Background="Transparent" Cursor="Hand"
                                                                MouseLeftButtonDown="CommunityFriend_Click">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource ChipBackgroundBrush}"
                                                                        ClipToBounds="True" Tag="15" SizeChanged="RoundCorners_SizeChanged">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Light" Opacity="0.35"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
<TextBlock Text="{Binding User}" FontSize="13" FontWeight="SemiBold"
                                                                           MouseEnter="UserName_MouseEnter" MouseLeave="UserName_MouseLeave"
                                                                           Cursor="Hand"
                                                                           Foreground="{Binding Badges, Converter={StaticResource UsernameBrushConv}, ConverterParameter=#EAEAEA}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                        <ContentControl Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                        Content="{Binding Badges, Converter={StaticResource BadgeIconRowConv}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Content="✕" Style="{StaticResource DangerPillButton}" Padding="8,5" FontSize="11"
                                                                        Click="CommunityRemoveFriend_Click" ToolTip="Remove friend" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="CommunityNoFriendsText" Text="No friends yet - find someone to play with!" FontSize="12"
